{
	"name": "live-website",
    "description": "A single-page, shareable website that embeds Literal Life Church's live stream video player",
	"version": "0.0.1",
    "private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "astro build",
		"postbuild": "node scripts/strip-legacy-env.mjs",

		"deploy": "astro build && wrangler deploy",
